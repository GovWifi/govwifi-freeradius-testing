rest {
    tls {
        verify_cert = no
        verify_cert_cn = no
    }

    authorize {
      noop
    }

    authenticate {
      noop
    }

    accounting {
      noop
    }

    post-auth {
        uri = "http://127.0.0.1/"
        method = 'post'
        data = "{ \
          \"user_name\": \"%{User-Name}\", \
          \"site_ip_address\": \"%{Client-IP-Address}\" \
          \"tls_version\": \"%{%{reply:TLS-Session-Version}:-unknown}\" \
          \"tls_cipher_suite\": \"%{%{reply:TLS-Session-Cipher-Suite}:-unknown}\", \
          \"eap_type\": \"%{%{request:EAP-Type}:-unknown}\" \
        }"
        body = 'json'
    }

    pool {
		start = ${thread[pool].start_servers}
		min = ${thread[pool].min_spare_servers}
		max = ${thread[pool].max_servers}
		spare = ${thread[pool].max_spare_servers}ß
		uses = 0
		lifetime = 0
		idle_timeout = 60

	}
}